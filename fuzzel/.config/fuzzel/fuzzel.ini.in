# Fuzzel — Catppuccin Mocha
# Rendered from this .in by palette/render.sh (colours are ${ctp_*} from
# palette/catppuccin-mocha.env). Matches the waybar/quickshell 12px-radius,
# 1px-border island language the rest of the desktop uses.
#
# This is the launcher (Mod+D, app + run). The dmenu-driven pickers
# (fz-clipboard, fz-emoji, fz-files, kp-fuzzel) share these colours via
# --config and pass their own --prompt.

[main]
font=JetBrainsMono Nerd Font:size=13
dpi-aware=no
prompt=Search
layer=overlay
width=45
lines=12
horizontal-pad=16
vertical-pad=12
inner-pad=10
tabs=2
line-height=22
terminal=ghostty -e

[border]
width=1
radius=12

[colors]
background=${ctp_base}f7
text=${ctp_text}ff
prompt=${ctp_subtext0}ff
placeholder=${ctp_overlay0}ff
input=${ctp_text}ff
match=${ctp_mauve}ff
selection=${ctp_mauve}40
selection-text=${ctp_text}ff
selection-match=${ctp_mauve}ff
counter=${ctp_overlay0}ff
border=${ctp_surface1}ff
