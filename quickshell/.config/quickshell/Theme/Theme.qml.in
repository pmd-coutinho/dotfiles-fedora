pragma Singleton
// Catppuccin Mocha tokens + shared shell metrics. RENDERED from Theme.qml.in
// by palette/render.sh — edit the .in template, never the rendered file.
import QtQuick
import Quickshell

Singleton {
    // ── palette ──
    readonly property color rosewater: "#${ctp_rosewater}"
    readonly property color flamingo: "#${ctp_flamingo}"
    readonly property color pink: "#${ctp_pink}"
    readonly property color mauve: "#${ctp_mauve}"
    readonly property color red: "#${ctp_red}"
    readonly property color maroon: "#${ctp_maroon}"
    readonly property color peach: "#${ctp_peach}"
    readonly property color yellow: "#${ctp_yellow}"
    readonly property color green: "#${ctp_green}"
    readonly property color teal: "#${ctp_teal}"
    readonly property color sky: "#${ctp_sky}"
    readonly property color sapphire: "#${ctp_sapphire}"
    readonly property color blue: "#${ctp_blue}"
    readonly property color lavender: "#${ctp_lavender}"
    readonly property color text: "#${ctp_text}"
    readonly property color subtext1: "#${ctp_subtext1}"
    readonly property color subtext0: "#${ctp_subtext0}"
    readonly property color overlay2: "#${ctp_overlay2}"
    readonly property color overlay1: "#${ctp_overlay1}"
    readonly property color overlay0: "#${ctp_overlay0}"
    readonly property color surface2: "#${ctp_surface2}"
    readonly property color surface1: "#${ctp_surface1}"
    readonly property color surface0: "#${ctp_surface0}"
    readonly property color base: "#${ctp_base}"
    readonly property color mantle: "#${ctp_mantle}"
    readonly property color crust: "#${ctp_crust}"

    // ── shared metrics (match the old waybar floating-islands look) ──
    readonly property string fontFamily: "JetBrainsMono Nerd Font"
    readonly property int fontSize: 13
    readonly property int barHeight: 30
    readonly property int barMarginTop: 3
    readonly property int barMarginSide: 10
    // Extra reserved space BELOW the bar, on top of the bar itself and its top
    // margin. This used to be a second barMarginTop (mimicking waybar's
    // margin-bottom) with nothing drawn in it, which put 14px between the bar
    // and the first window once niri's own `gaps 8` was added. 0 leaves niri's
    // gap as the only separation.
    readonly property int barGapBelow: 0
    readonly property int islandRadius: 12   // matches niri window corners
    readonly property color islandBg: Qt.alpha(base, 0.92)
    readonly property color islandBorder: Qt.alpha(surface0, 0.9)

    // ── type scale ──
    // Named by role rather than by number so a size change lands everywhere it
    // should. These are the sizes the shell already used as `fontSize ± n`.
    readonly property int fontTiny: fontSize - 3    // count badges, hints
    readonly property int fontSmall: fontSize - 2   // menu rows, captions
    readonly property int fontLabel: fontSize - 1   // secondary text (commonest)
    readonly property int fontMedium: fontSize + 1  // emphasised inline text
    readonly property int fontLarge: fontSize + 3   // panel headings
    readonly property int fontXLarge: fontSize + 4  // OSD glyph, media buttons

    // ── radius scale ──
    // Pill shapes (badges, toggles, progress bars) deliberately use `height / 2`
    // at the call site instead of a token — that's the shape, not a style choice.
    readonly property int radiusSmall: 6            // menu rows
    readonly property int radiusMedium: 8           // cards, workspace pills

    // ── animation ──
    readonly property int durationFast: 80          // OSD level bar
    readonly property int durationShort: 150        // toggle knobs
    readonly property int durationMedium: 200       // workspace pill width
    readonly property int durationPulse: 900        // recording indicator breath

    // ── spacing scale ──
    // Applied only where the existing literal already matched, so the sweep is
    // pixel-identical; a handful of one-off 2/6/10/14px gaps stay inline rather
    // than be rounded into the scale and shift the bar around.
    readonly property int spacingXs: 4
    readonly property int spacingSm: 8
    readonly property int spacingMd: 12
    readonly property int spacingLg: 16
    readonly property int spacingXl: 24

    // translucent helper for one-off alpha shades
    function alpha(c, a) { return Qt.alpha(c, a); }

    // shared load ramp for the CPU/memory readouts (they used identical
    // thresholds inline); negative means "no reading yet"
    function loadColor(pct) {
        if (pct < 0)
            return overlay0;
        return pct >= 90 ? red : pct >= 70 ? peach : subtext0;
    }

    // Glyphs live in Theme/Icons.qml — they don't depend on the palette, so they
    // stay out of this generated file.
}
