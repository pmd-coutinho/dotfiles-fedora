#!/usr/bin/env bash
# screen-record — start/stop a screen recording (niri/Wayland).
#
# Run it once to pick a region (or single-click a monitor for that whole output,
# same trick as screenshot-region) and start recording; run it again to stop.
# One pidfile in $XDG_RUNTIME_DIR is the whole state machine, so the same
# keybind toggles.
#
# Recorder: wf-recorder first, wl-screenrec second. That order is deliberate and
# machine-specific — wl-screenrec is the better tool (GPU-encoded, cheap on CPU)
# but it ALWAYS builds a VAAPI filter chain, even with --no-hw, and VAAPI encode
# is unavailable on this laptop:
#   * libva can't auto-select a driver at all
#   * LIBVA_DRIVER_NAME=iHD connects to the Intel iGPU but reports
#     "No usable encoding profile found"
#   * the NVIDIA render node isn't supported by iHD
# so every wl-screenrec run dies in Parsed_scale_vaapi. wf-recorder encodes with
# software x264 through ffmpeg and works. Set SCREENREC_BIN to force one.
# Both finalise the container on SIGINT — SIGKILL leaves a corrupt file, so
# never kill -9 this.
#
# Tells quickshell so the bar can show a recording indicator; the ipc call is
# best-effort so the script still works with the shell stopped.
set -euo pipefail

outdir="${SCREENREC_DIR:-$HOME/Videos/Screencasts}"
pidfile="${XDG_RUNTIME_DIR:-/tmp}/screen-record.pid"

notify() { command -v notify-send >/dev/null 2>&1 && notify-send -a screen-record "$@" || true; }
shell_ipc() { qs ipc call recorder "$1" >/dev/null 2>&1 || true; }

# ── stop an in-flight recording ───────────────────────────────────────────
# pidfile holds two lines: the encoder pid and the file it is writing, so the
# stop path can name the exact file instead of guessing at the newest one
if [ -s "$pidfile" ]; then
    { read -r pid; read -r recfile || recfile=""; } < "$pidfile"
    if kill -0 "$pid" 2>/dev/null; then
        # SIGINT, not SIGTERM: wf-recorder only writes the moov atom on SIGINT
        kill -INT "$pid" 2>/dev/null || true
        # give the encoder a moment to flush before we claim it's saved
        for _ in $(seq 1 50); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.1
        done
    fi
    rm -f "$pidfile"
    shell_ipc stopped
    # Don't claim success blindly: wf-recorder only writes frames when the
    # captured region CHANGES, so recording something static produces no file at
    # all. Saying "saved" and leaving nothing behind is the worst outcome.
    if [ -n "$recfile" ] && [ -s "$recfile" ]; then
        notify "Recording saved" "$(basename "$recfile")  ($(du -h "$recfile" | cut -f1))"
    elif [ -n "$recfile" ]; then
        rm -f "$recfile"
        notify "Recording produced nothing" "nothing on screen changed in that region"
    else
        notify "Recording stopped" "check $outdir"
    fi
    exit 0
fi

# ── start a new one ───────────────────────────────────────────────────────
command -v slurp >/dev/null 2>&1 || { notify "screen-record" "slurp is not installed"; exit 1; }

if [ -n "${SCREENREC_BIN:-}" ]; then
    recorder="$SCREENREC_BIN"
elif command -v wf-recorder >/dev/null 2>&1; then
    recorder=wf-recorder
elif command -v wl-screenrec >/dev/null 2>&1; then
    recorder=wl-screenrec
else
    notify "screen-record" "install wf-recorder"
    exit 1
fi

# Monitor rectangles in the logical coordinate space slurp uses, so a single
# click grabs a whole output. Mirrors the jq in screenshot-region — kept inline
# because scripts on PATH should not depend on each other.
boxes=$(niri msg --json outputs \
  | jq -r 'to_entries[] | .value.logical | "\(.x),\(.y) \(.width)x\(.height)"')

# slurp exits non-zero on cancel → quit quietly, nothing started
geom=$(printf '%s\n' "$boxes" | slurp -d) || exit 0

mkdir -p "$outdir"
file="$outdir/$(date +%Y-%m-%d_%H-%M-%S).mp4"

# --audio needs a running pipewire; pass -a/--audio through to opt in
audio=""
[ "${1:-}" = "-a" ] && audio="--audio"

# Codec, for wf-recorder only (wl-screenrec picks its own).
#
# Fedora ships ffmpeg-free, which has NO libx264 — wf-recorder's default lands
# on VP9, and VP9 inside .mp4 is legal but awkward to share. h264_nvenc encodes
# on the RTX 4080 for near-zero CPU, with libopenh264 as the software fallback
# (much smaller files at the default bitrate, but it works anywhere).
codec=""
if [ "$(basename "$recorder")" = "wf-recorder" ] && command -v ffmpeg >/dev/null 2>&1; then
    encoders=$(ffmpeg -hide_banner -encoders 2>/dev/null)
    if grep -q ' h264_nvenc' <<< "$encoders"; then
        codec="h264_nvenc"
    elif grep -q ' libopenh264' <<< "$encoders"; then
        codec="libopenh264"
    fi
fi

# setsid so the recorder outlives this shell, and so the pid we store is the
# encoder itself (not a wrapper) for the SIGINT above to reach
# shellcheck disable=SC2086  # $audio/$codec are deliberate optional flags
setsid -f "$recorder" -g "$geom" -f "$file" ${codec:+-c "$codec"} $audio >/dev/null 2>&1

# setsid -f detaches, so find the pid by matching the output file we just chose
sleep 0.4
pid=$(pgrep -n -f "$recorder.*$file" || true)
if [ -z "$pid" ]; then
    notify "screen-record" "$recorder failed to start — try running it by hand"
    exit 1
fi
printf '%s\n%s\n' "$pid" "$file" > "$pidfile"

shell_ipc started
notify "Recording started" "$(basename "$file")${audio:+  (with audio)}"
